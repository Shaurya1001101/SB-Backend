# SkillBridge Backend Environment Configuration Example
# Copy this file to .env or .env.local and fill in your Supabase connection string.

# Port for local Express API server
PORT=5000

# Supabase PostgreSQL Connection String (Pooler - IPv4 Compatible)
# Format: postgresql://[user]:[password]@[pooler-host]:6543/[database]
DATABASE_URL="postgresql://postgres.xabzaaychzdpgtbgcrcx:[YOUR_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# Optional: OpenAI API Key for live AI responses (falls back to rule-based engine if empty)
VITE_AI_KEY=""
